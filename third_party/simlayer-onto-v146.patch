@@ -0,0 +1,166 @@
+/*
+ * Internal runtime for thrl of taisei-sim.
+ */
+#include "runtime.h"
+
+#include "audio/audio.h"
+#include "resource/bgm.h"
+#include "cli.h"
+#include "config.h"
+#include "coroutine/coroutine.h"
+#include "dynstage.h"
+#include "events.h"
+#include "filewatch/filewatch.h"
+#include "gamepad.h"

diff --git a/src/sim/meson.build b/src/sim/meson.build
new file mode 100644
index 00000000..cc33a783
--- /dev/null
+++ b/src/sim/meson.build
@@ -0,0 +1,34 @@
+# Headless simulation C API (taisei_sim_*).
+#
+# src/meson.build (added by the taisei-sim fork) calls subdir('sim') but the
+# fork never committed this file, so the meson build fails without it. This
+# reconstruction compiles the sim into the main taisei executable and exports
+# the C API:
+#
+#   - sim.c / runtime.c are appended to taisei_main_src (the executable's
+#     extra sources; the executable is declared right after this subdir()).
+#   - TAISEI_SIM_BUILD enables the export decorators in taisei_sim.h
+#     (__declspec(dllexport) on Windows, default visibility elsewhere).
+#
+# The whole project only ever includes sim/taisei_sim.h from these two files,
+# so scoping the define to the executable's own sources has no other effect.
+# (add_project_arguments can't be used here: the subdir() targets have already
+# been declared, and meson forbids project args after a target declaration.)
+
+taisei_sim_c_args = ['-DTAISEI_SIM_BUILD']
+
+taisei_main_src += files('sim.c', 'runtime.c')
+
+# The Python harness loads this shared module, NOT the executable:
+# a real DLL runs its DllMain (mingw CRT init) when LoadLibrary() is called.
+# An EXE loaded via LoadLibrary never runs its CRT entry point, so every CRT
+# call inside it (snprintf/fopen/malloc) crashes. (Verified empirically:
+# a pure-snprintf probe exported by the exe access-violated.)
+# Everything (SDL3 included) is linked statically, so the DLL is self-contained
+# apart from the mingw runtime DLLs (libgcc_s_seh-1, libwinpthread, libstdc++).
+taisei_sim = shared_module('taisei_sim',
+    files('sim.c', 'runtime.c'),
+    c_args : taisei_sim_c_args,
+    dependencies : libtaisei_dep,
+    install : false,
+)

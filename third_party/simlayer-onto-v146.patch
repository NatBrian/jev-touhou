+# has_function() is a LINK check. On MinGW-w64 the CRT exports the
+# posix_memalign / aligned_alloc symbols, but NO header declares them, so the
+# checks pass while the real compile fails with
+#   error: implicit declaration of function 'posix_memalign'
+#         [-Werror=implicit-function-declaration]
+# (observed with MSYS2 GCC 16, 2026-09-25). Force the checks to also require a
+# visible declaration from <stdlib.h>. On Windows this correctly leaves only
+# the WIN32 _aligned_malloc path (declared via <corecrt_malloc.h>).
+malloc_check_args = ['-Werror=implicit-function-declaration']
+malloc_check_prefix = '#include <stdlib.h>\n#include <stddef.h>\n'
+config.set('TAISEI_BUILDCONF_HAVE_ALIGNED_ALLOC',

+static uint64_t abi_hash_u64(uint64_t hash, uint64_t value) {
+    for(uint32_t i = 0; i < 8; ++i) {
+        hash ^= (value >> (i * 8)) & UINT64_C(0xff);
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
